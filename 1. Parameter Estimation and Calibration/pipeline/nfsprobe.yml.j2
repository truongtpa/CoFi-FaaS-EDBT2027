name: nfsprobe
description:

variables:
  enable_bf: $enable_bf
  enable_nfs_shuffle: $enable_nfs_shuffle
  bucket: $bucket
  base_path: $base_path
  s3_metadata: '$s3_metadata/{{ bucket }}.json'
  nfs_folder: '/mnt/filters'

steps:
  - name: step1-write-nfs
    func: scan
    input: 's3://{{ bucket }}/lineitem.parquet'
    from_previous_task: None
    max_size_mb: 5
    max_parallel: 70
    params:
      select: SELECT l_orderkey, l_partkey, l_suppkey, l_quantity, l_extendedprice, l_discount, l_shipdate
      sql_clauses: WHERE l_orderkey % 2 = 0
      output_file: '{{ base_path }}/nfsprobe/$task_name/$random.parquet'

  - name: step2-nfs-read
    func: aggregate
    from_previous_task: step1-write-nfs
    params:
      sql_clauses: WHERE l_orderkey + l_partkey + l_suppkey + l_quantity + l_extendedprice + l_discount + year(l_shipdate) < 0
      output_file: '{{ base_path }}/nfsprobe/$task_name/$random.parquet'

  - name: step3-summary-clean
    func: summary_clean
    params:
      output_s3: '{{ base_path }}/nfsprobe'
      nfs_folder: '{{ nfs_folder }}'
      is_delete: True
