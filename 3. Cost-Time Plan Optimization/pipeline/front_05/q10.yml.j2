name: q10
description: TPC-H Query 10
variables:
  enable_bf: 1
  enable_nfs_shuffle: $enable_nfs_shuffle
  bucket: $bucket
  base_path: $base_path
  s3_metadata: $s3_metadata/$bucket.json
  nfs_folder: /mnt/filters
  parm1: $parm1
steps:
- name: step1-orders
  func: scan
  input: s3://$bucket/orders.parquet
  from_previous_task: None
  params:
    select: SELECT o_orderkey, o_custkey
    sql_clauses: "WHERE o_orderdate >= DATE '$parm1'\n  AND o_orderdate < DATE '$parm1'\
      \ + INTERVAL 3 MONTH\n  AND o_custkey IS NOT NULL\n  AND o_orderkey IS NOT NULL\n"
    output_file: $base_path/$task_name/$random.parquet
  max_size_mb: 100
- name: step1-orders--combine
  func: aggregate
  from_previous_task: step1-orders
  params:
    output_file: $base_path/$task_name/$random.parquet
    bf_column: o_custkey
    bf_path: /mnt/filters/$task_name/$random.bin
    est_elements: 3700000
  max_size_mb: 25
- name: step1-orders--mergebf
  func: merge_bf
  from_previous_task: step1-orders--combine
  params:
    file_output: /mnt/filters/$task_name/$random.bin
    error_rate: 0.001
- name: step2-customer
  func: scan
  input: s3://$bucket/customer.parquet
  from_previous_task: step1-orders--mergebf
  params:
    select: 'SELECT c_custkey, c_name, c_address, c_nationkey, c_phone, c_acctbal,
      c_comment

      '
    sql_clauses: "WHERE c_custkey IS NOT NULL\n  AND c_nationkey IS NOT NULL\n"
    output_file: $base_path/$task_name/$random.parquet
    bf_column: c_custkey
    filter_by_bf: true
  max_size_mb: 100
- name: step2-customer--combine
  func: aggregate
  from_previous_task: step2-customer
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step3-join-orders-customer
  func: broadcast_join
  from_previous_task:
  - step1-orders--combine
  - step2-customer--combine
  params:
    probe_select: "SELECT c_custkey, c_name, c_address, c_nationkey,\n       c_phone,\
      \ c_acctbal, c_comment, o_orderkey\n"
    join_condition: o_custkey = c_custkey
    output_file: $base_path/$task_name/$random.parquet
  max_size_mb: 10
- name: step3-join-orders-customer--combine
  func: aggregate
  from_previous_task: step3-join-orders-customer
  params:
    output_file: $base_path/$task_name/$random.parquet
    bf_column: o_orderkey
    bf_path: /mnt/filters/$task_name/$random.bin
    est_elements: 850000
- name: step3-join-orders-customer--mergebf
  func: merge_bf
  from_previous_task: step3-join-orders-customer--combine
  params:
    file_output: /mnt/filters/$task_name/$random.bin
    error_rate: 0.001
- name: step4-lineitem
  func: scan
  input: s3://$bucket/lineitem.parquet
  from_previous_task: step3-join-orders-customer--mergebf
  params:
    select: SELECT l_orderkey, l_extendedprice, l_discount
    sql_clauses: 'WHERE l_returnflag = ''R'' AND l_orderkey IS NOT NULL

      '
    output_file: $base_path/$task_name/$random.parquet
    bf_column: l_orderkey
    filter_by_bf: true
  max_size_mb: 100
- name: step4-lineitem--combine
  func: aggregate
  from_previous_task: step4-lineitem
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step5-nation
  func: scan
  input: s3://$bucket/nation.parquet
  from_previous_task: None
  params:
    select: SELECT n_nationkey, n_name
    sql_clauses: WHERE n_nationkey IS NOT NULL
    output_file: $base_path/$task_name/$random.parquet
- name: step5-nation--combine
  func: aggregate
  from_previous_task: step5-nation
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step6-join-customer-orders-lineitem
  func: broadcast_join
  from_previous_task:
  - step3-join-orders-customer--combine
  - step4-lineitem--combine
  params:
    probe_select: "SELECT c_custkey, c_name, c_address, c_nationkey,\n       c_phone,\
      \ c_acctbal, c_comment,\n       l_extendedprice * (1 - l_discount) AS revenue\n"
    join_condition: o_orderkey = l_orderkey
    output_file: $base_path/$task_name/$random.parquet
- name: step6-join-customer-orders-lineitem--combine
  func: aggregate
  from_previous_task: step6-join-customer-orders-lineitem
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step7-join-nation
  func: broadcast_join
  from_previous_task:
  - step5-nation--combine
  - step6-join-customer-orders-lineitem--combine
  params:
    probe_select: "SELECT c_custkey, c_name, c_address, c_phone,\n       c_acctbal,\
      \ c_comment, revenue, n_name\n"
    join_condition: c_nationkey = n_nationkey
    output_file: $base_path/$task_name/$random.parquet
- name: step7-join-nation--combine
  func: aggregate
  from_previous_task: step7-join-nation
  params:
    select: "SELECT c_custkey, c_name,\n       SUM(revenue) AS revenue,\n       c_acctbal,\
      \ n_name, c_address, c_phone, c_comment\n"
    sql_clauses: 'GROUP BY c_custkey, c_name, c_acctbal, c_phone, n_name, c_address,
      c_comment ORDER BY revenue DESC

      '
    output_file: $base_path/$task_name/$random.parquet
- name: step8-summary-clean
  func: summary_clean
  params:
    output_s3: $base_path
    nfs_folder: /mnt/filters
    is_delete: true
