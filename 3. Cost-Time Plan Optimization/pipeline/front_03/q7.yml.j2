name: q7
description: TPC-H Query 07 - Volume Shipping Query
variables:
  enable_bf: 1
  enable_nfs_shuffle: $enable_nfs_shuffle
  bucket: $bucket
  base_path: $base_path
  s3_metadata: $s3_metadata/$bucket.json
  nfs_folder: /mnt/filters
  parm1: $parm1
  parm2: $parm2
steps:
- name: step1-nation
  func: scan
  input: s3://$bucket/nation.parquet
  from_previous_task: None
  params:
    select: SELECT n_nationkey, n_name
    sql_clauses: "WHERE n_name IN ('$parm1', '$parm2')\n  AND n_nationkey IS NOT NULL\n"
    output_file: $base_path/$task_name/$random.parquet
- name: step1-nation--combine
  func: aggregate
  from_previous_task: step1-nation
  params:
    output_file: $base_path/$task_name/$random.parquet
    bf_column: n_nationkey
    bf_path: /mnt/filters/$task_name/$random.bin
    est_elements: 2
- name: step1-nation--mergebf
  func: merge_bf
  from_previous_task: step1-nation--combine
  params:
    file_output: /mnt/filters/$task_name/$random.bin
    error_rate: 0.001
- name: step2-supplier
  func: scan
  input: s3://$bucket/supplier.parquet
  from_previous_task: step1-nation--mergebf
  params:
    select: SELECT s_suppkey, s_nationkey
    sql_clauses: "WHERE s_suppkey IS NOT NULL\n  AND s_nationkey IS NOT NULL\n"
    output_file: $base_path/$task_name/$random.parquet
    bf_column: s_nationkey
    filter_by_bf: true
- name: step2-supplier--combine
  func: aggregate
  from_previous_task: step2-supplier
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step3-customer
  func: scan
  input: s3://$bucket/customer.parquet
  from_previous_task: step1-nation--mergebf
  params:
    select: SELECT c_custkey, c_nationkey
    sql_clauses: "WHERE c_custkey IS NOT NULL\n  AND c_nationkey IS NOT NULL\n"
    output_file: $base_path/$task_name/$random.parquet
    bf_column: c_nationkey
    filter_by_bf: true
- name: step3-customer--combine
  func: aggregate
  from_previous_task: step3-customer
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step4-orders
  func: scan
  input: s3://$bucket/orders.parquet
  from_previous_task: None
  params:
    select: SELECT o_orderkey, o_custkey
    sql_clauses: "WHERE o_custkey IS NOT NULL\n  AND o_orderkey IS NOT NULL\n"
    output_file: $base_path/$task_name/$random.parquet
- name: step4-orders--combine
  func: aggregate
  from_previous_task: step4-orders
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step5-lineitem
  func: scan
  input: s3://$bucket/lineitem.parquet
  from_previous_task: None
  params:
    select: SELECT l_orderkey, l_suppkey, l_extendedprice, l_discount, l_shipdate
    sql_clauses: "WHERE l_shipdate >= DATE '1995-01-01'\n  AND l_shipdate <= DATE\
      \ '1996-12-31'\n  AND l_orderkey IS NOT NULL\n  AND l_suppkey IS NOT NULL\n"
    output_file: $base_path/$task_name/$random.parquet
  max_size_mb: 200
- name: step5-lineitem--combine
  func: aggregate
  from_previous_task: step5-lineitem
  params:
    output_file: $base_path/$task_name/$random.parquet
  max_size_mb: 100
- name: step6-join-customer-orders
  func: broadcast_join
  from_previous_task:
  - step3-customer--combine
  - step4-orders--combine
  params:
    probe_select: SELECT o_orderkey, c_nationkey
    join_condition: c_custkey = o_custkey
    output_file: $base_path/$task_name/$random.parquet
- name: step6-join-customer-orders--combine
  func: aggregate
  from_previous_task: step6-join-customer-orders
  params:
    output_file: $base_path/$task_name/$random.parquet
  max_size_mb: 25
- name: step7-join-lineitem
  func: broadcast_join
  from_previous_task:
  - step6-join-customer-orders--combine
  - step5-lineitem--combine
  params:
    probe_select: 'SELECT l_suppkey, c_nationkey, l_extendedprice, l_discount, l_shipdate

      '
    join_condition: o_orderkey = l_orderkey
    output_file: $base_path/$task_name/$random.parquet
- name: step7-join-lineitem--combine
  func: aggregate
  from_previous_task: step7-join-lineitem
  params:
    output_file: $base_path/$task_name/$random.parquet
  max_size_mb: 10
- name: step8-join-supplier
  func: broadcast_join
  from_previous_task:
  - step2-supplier--combine
  - step7-join-lineitem--combine
  params:
    probe_select: 'SELECT s_nationkey, c_nationkey, l_extendedprice, l_discount, l_shipdate

      '
    join_condition: l_suppkey = s_suppkey
    output_file: $base_path/$task_name/$random.parquet
  max_size_mb: 25
- name: step8-join-supplier--combine
  func: aggregate
  from_previous_task: step8-join-supplier
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step9-join-nation-supplier
  func: broadcast_join
  from_previous_task:
  - step1-nation--combine
  - step8-join-supplier--combine
  params:
    probe_select: 'SELECT n_name AS supp_nation, c_nationkey, l_extendedprice, l_discount,
      l_shipdate

      '
    join_condition: s_nationkey = n_nationkey
    output_file: $base_path/$task_name/$random.parquet
- name: step9-join-nation-supplier--combine
  func: aggregate
  from_previous_task: step9-join-nation-supplier
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step10-join-nation-customer
  func: broadcast_join
  from_previous_task:
  - step1-nation--combine
  - step9-join-nation-supplier--combine
  params:
    probe_select: 'SELECT supp_nation, n_name AS cust_nation, l_extendedprice, l_discount,
      l_shipdate

      '
    join_condition: "c_nationkey = n_nationkey AND (\n  (supp_nation = '$parm1' AND\
      \ n_name = '$parm2')\n  OR\n  (supp_nation = '$parm2' AND n_name = '$parm1')\n\
      )\n"
    output_file: $base_path/$task_name/$random.parquet
- name: step10-join-nation-customer--combine
  func: aggregate
  from_previous_task: step10-join-nation-customer
  params:
    output_file: $base_path/$task_name/$random.parquet
- name: step11-agg
  func: aggregate
  from_previous_task: step10-join-nation-customer--combine
  params:
    select: "SELECT supp_nation, cust_nation,\n       YEAR(l_shipdate) AS l_year,\n\
      \       SUM(l_extendedprice * (1 - l_discount)) AS revenue\n"
    sql_clauses: 'GROUP BY supp_nation, cust_nation, YEAR(l_shipdate) ORDER BY supp_nation,
      cust_nation, l_year

      '
    output_file: $base_path/$task_name/$random.parquet
- name: step12-summary-clean
  func: summary_clean
  params:
    output_s3: $base_path
    nfs_folder: /mnt/filters
    is_delete: true
